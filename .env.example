# ============================================================
# EFADT Environment Variables
# Copy to .env and fill in values
# ============================================================

# System Paths
CONFIG_PATH=configs/hyperparams.yaml
BUILDING_CONFIG=configs/building_params.yaml
DATA_DIR=data/raw
CHECKPOINT_DIR=models/lstm/checkpoints
AUDIT_LOG_DIR=data/audit

# API
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
API_RELOAD=true

# Privacy Budgets (set to match paper: ε=1.0, δ=1e-5)
DP_EPSILON=1.0
DP_DELTA=1e-5
DP_CLIP_NORM=1.0

# FL Training
FL_ROUNDS=100
FL_N_BUILDINGS=12
FL_SEED=42

# Experiment Tracking
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=efadt-campus

# Dashboard
DASHBOARD_PORT=8501
