{
 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["# EFADT — 03 Decision Cycle Demo\n\nEnd-to-end walkthrough of one 30-second decision cycle:\n- Sync DT state from sensors\n- Evaluate all candidate HVAC actions\n- Select optimal action\n- Compute SHAP + trust score\n- Inspect audit record"]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import sys\n",
    "sys.path.insert(0, '..')\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "plt.style.use('seaborn-v0_8-whitegrid')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Set up building B02 (Engineering Building) on a hot exam-day afternoon\n",
    "from digital_twin.simulator import DigitalTwinSimulator\n",
    "from digital_twin.thermal_model import BuildingThermalParams, ThermalState\n",
    "from agent.action_space import build_action_space, get_hvac_powers\n",
    "from agent.utility_function import UtilityWeights, select_optimal_action, utility_summary\n",
    "from xai.trust_scorer import TrustWeights, compute_trust_score\n",
    "\n",
    "params = BuildingThermalParams(alpha=0.0020, beta=0.010, gamma=0.009, P_cap=25.0)\n",
    "sim = DigitalTwinSimulator('B02', params=params, H=6, o_max=80)\n",
    "\n",
    "# Scenario: hot afternoon, high occupancy (exam)\n",
    "state = ThermalState(T_in=27.5, T_out=42.0, Q_hvac=-5.0, occupancy=72)\n",
    "sim.sync_state(state)\n",
    "\n",
    "# Occupancy forecast (slightly decreasing after peak)\n",
    "occ_forecast = np.array([72, 75, 74, 70, 65, 60])\n",
    "print(f'State: T_in={state.T_in}°C | T_out={state.T_out}°C | Occupancy={state.occupancy}')\n",
    "print(f'Forecast: {occ_forecast}')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Evaluate all candidate HVAC actions\n",
    "action_space = build_action_space(hvac_min_kw=-25.0, hvac_max_kw=25.0, hvac_step_kw=2.5)\n",
    "hvac_powers = get_hvac_powers(action_space)\n",
    "all_scores = sim.evaluate_all_actions(hvac_powers, occ_forecast)\n",
    "\n",
    "weights = UtilityWeights(lambda_e=0.5, lambda_c=0.35, lambda_d=0.15)\n",
    "best_score, best_utility = select_optimal_action(all_scores, weights)\n",
    "best_action = action_space[best_score.action_id]\n",
    "\n",
    "print(f'\\nOptimal action: Q = {best_action.hvac_power_kw:+.1f} kW (setpoint {best_action.hvac_setpoint_c:.1f}°C)')\n",
    "print(f'E(u*) = {best_score.E:.3f} | C(u*) = {best_score.C:.3f} | D(u*) = {best_score.D:.3f}')\n",
    "print(f'Utility = {best_utility:.4f} | Feasible = {best_score.feasible}')\n",
    "print(f'T_trajectory: {best_score.T_trajectory.round(2)}')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Visualize action space utility landscape\n",
    "summary = utility_summary(all_scores, weights)\n",
    "feasible_only = [s for s in summary if s['feasible']]\n",
    "\n",
    "fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(14, 5))\n",
    "\n",
    "# Utility by HVAC power\n",
    "powers_all = [s['hvac_kw'] for s in summary]\n",
    "utils_all = [s['utility'] if s['utility'] < 100 else np.nan for s in summary]\n",
    "colors = ['#4CAF50' if s['feasible'] else '#EF5350' for s in summary]\n",
    "ax1.bar(range(len(summary)), utils_all, color=colors, edgecolor='none')\n",
    "ax1.axvline(best_score.action_id, color='gold', lw=2, label=f'u* = {best_action.hvac_power_kw:+.1f} kW')\n",
    "ax1.set_xlabel('Action Index')\n",
    "ax1.set_ylabel('Utility (lower = better)')\n",
    "ax1.set_title('Utility Landscape over Full Action Space')\n",
    "ax1.legend()\n",
    "from matplotlib.patches import Patch\n",
    "ax1.legend(handles=[Patch(color='#4CAF50', label='Feasible'),\n",
    "                     Patch(color='#EF5350', label='Infeasible'),\n",
    "                     plt.Line2D([0], [0], color='gold', lw=2, label=f'u* Q={best_action.hvac_power_kw:+.1f}kW')])\n",
    "\n",
    "# T_trajectory for optimal vs. no-action\n",
    "null_score = next((s for s in all_scores if abs(s.hvac_power_kw) < 0.1), all_scores[0])\n",
    "steps = np.arange(1, 7) * 0.5  # minutes\n",
    "ax2.plot(steps, best_score.T_trajectory, 'o-', color='steelblue', label=f'u* (Q={best_action.hvac_power_kw:+.1f}kW)')\n",
    "ax2.plot(steps, null_score.T_trajectory, 's--', color='tomato', label='No action (Q=0)')\n",
    "ax2.axhspan(20, 26, alpha=0.1, color='green', label='Comfort band [20-26°C]')\n",
    "ax2.set_xlabel('Time (minutes)')\n",
    "ax2.set_ylabel('Indoor Temperature (°C)')\n",
    "ax2.set_title('Simulated Temperature Trajectory (H=6 steps)')\n",
    "ax2.legend()\n",
    "plt.tight_layout()\n",
    "plt.savefig('../docs/decision_cycle.png', dpi=150, bbox_inches='tight')\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Trust score + SHAP explanation\n",
    "rng = np.random.default_rng(42)\n",
    "FEATURES = ['occupancy','co2_ppm','temperature_in','temperature_out',\n",
    "            'humidity','hvac_power_kw','hvac_setpoint','motion_count',\n",
    "            'hour_sin','hour_cos','day_of_week_sin','day_of_week_cos','month_sin','month_cos']\n",
    "\n",
    "# Simulate realistic SHAP values for high-occupancy hot scenario\n",
    "shap_vals = rng.normal(0, 0.15, 14)\n",
    "shap_vals[0] = 0.52   # occupancy: most important\n",
    "shap_vals[2] = -0.41  # T_in: cooling needed\n",
    "shap_vals[3] = -0.29  # T_out: hot outside\n",
    "shap_vals[1] = 0.18   # CO2: high\n",
    "\n",
    "tw = TrustWeights(eta1=0.5, eta2=0.3, eta3=0.2)\n",
    "result = compute_trust_score(shap_vals, best_score.C, best_score.D, weights=tw)\n",
    "\n",
    "print(f'Trust Score: τ = {result.tau:.3f}')\n",
    "print(f'  SHAP coherence term (η₁): {result.shap_coherence:.3f}')\n",
    "print(f'  Comfort alignment (η₂):   {result.comfort_alignment:.3f}')\n",
    "print(f'  Safety alignment (η₃):    {result.safety_alignment:.3f}')\n",
    "print(f'  Below threshold?           {result.below_threshold}')\n",
    "\n",
    "# SHAP waterfall\n",
    "sorted_idx = np.argsort(np.abs(shap_vals))[::-1]\n",
    "fig, ax = plt.subplots(figsize=(10, 5))\n",
    "colors = ['steelblue' if v > 0 else 'tomato' for v in [shap_vals[i] for i in sorted_idx]]\n",
    "ax.barh([FEATURES[i] for i in sorted_idx], [shap_vals[i] for i in sorted_idx], color=colors)\n",
    "ax.axvline(0, color='black', lw=0.8)\n",
    "ax.set_xlabel('SHAP φⱼ')\n",
    "ax.set_title(f'SHAP Feature Attribution — τ = {result.tau:.3f}')\n",
    "plt.tight_layout()\n",
    "plt.savefig('../docs/shap_attribution.png', dpi=150, bbox_inches='tight')\n",
    "plt.show()"
   ]
  }
 ],
